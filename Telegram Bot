user_reminders = {}

def parse_time_command(text):
   
    text = text.lower().replace("через ", "").replace(" in ", "")
    
    if "сек" in text or "sec" in text:
        multiplier = 1
        num_str = ''.join(filter(str.isdigit, text))
    elif "мин" in text or "min" in text:
        multiplier = 60
        num_str = ''.join(filter(str.isdigit, text))
    elif "час" in text or "hour" in text:
        multiplier = 3600
        num_str = ''.join(filter(str.isdigit, text))
    elif "день" in text or "day" in text:
        multiplier = 86400
        num_str = ''.join(filter(str.isdigit, text))
    else:
        return None
        
    try:
        value = int(num_str)
        return value * multiplier
    except ValueError:
        return None

@bot.message_handler(commands=['start'])
def send_welcome(message):
    bot.reply_to(message, "Привет! Я бот-напоминалка.Отправь мне сообщение в формате:<code>Напомнить через X минут Текст</code> Пример:Напомнить через 5 минут Выпить воды")

@bot.message_handler(func=lambda message: True)
def handle_all_messages(message):
    if message.text.lower().startswith("напомнить ") or message.text.lower().startswith("remind "):
        
        if " через " in message.text.lower():
            parts = message.text.split(" через ", 1)
        elif " in " in message.text.lower():
            parts = message.text.split(" in ", 1)
        else:
            bot.reply_to(message, "Неверный формат. Используйте: 'Напомнить через 10 минут Текст'")
            return
            
        if len(parts) < 2:
            bot.reply_to(message, " Не удалось распознать команду.")
            return
            
        time_part = parts[1].split(" ", 1)[0] + " " + parts[1].split(" ", 1)[1] if " " in parts[1] else parts[1]
        title_part = parts[1][len(time_part):].strip()
        
        delay_seconds = parse_time_command(time_part)
        
        if not delay_seconds or delay_seconds <= 0:
            bot.reply_to(message, "Ошибка во времени. Напишите число больше нуля (например: 'через 5 минут').")
            return
            
        if not title_part:
            bot.reply_to(message, "Вы забыли написать текст самого напоминания.")
            return
            
        if delay_seconds > 7 * 24 * 60 * 60:
            bot.reply_to(message, " Слишком большой интервал. Максимум — 7 дней.")
            return
            
        run_timestamp = time.time() + delay_seconds
        
        user_reminders[message.chat.id] = {
            "title": title_part,
            "timestamp": run_timestamp
        }
        
        wait_minutes = round(delay_seconds / 60, 1)
        bot.reply_to(message, f" Хорошо!Я напомню вам:<b>{title_part}</b>Через {wait_minutes} мин.")
        
        threading.Thread(target=wait_and_notify, args=(message.chat.id,)).start()
    else:
        bot.reply_to(message, "Чтобы создать напоминание, напишите команду, например:Напомнить через 1 час Позвонить маме")

def wait_and_notify(chat_id):
    reminder = user_reminders.get(chat_id)
    if not reminder:
        return
    
    now_ts = time.time()
    sleep_duration = reminder["timestamp"] - now_ts
    
    if sleep_duration > 0:
        time.sleep(sleep_duration)
        
    try:
        bot.send_message(chat_id, f"<b>Напоминание:</b>{reminder['title']}")
    except Exception as e:
        print(f"Ошибка отправки пользователю {chat_id}: {e}")
    finally:
        if chat_id in user_reminders:
            del user_reminders[chat_id]

