a = int(input("Введите целое число: "))

if a < 0 or (a % 10 == 0 and a != 0):
    print(False)
else:
    reversed = 0

    while a > reversed:
        reversed = reversed * 10 + a % 10 
        a //= 10                                     

    if a == reversed or a == reversed // 10:
        print(True)
    else:
        print(False)
